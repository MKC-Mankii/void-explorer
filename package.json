{
  "name": "void-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "node tests/e2e.mjs",
    "format": "prettier --write src tests index.html vite.config.ts README.md docs .github package.json tsconfig.json",
    "format:check": "prettier --check src tests index.html vite.config.ts README.md docs .github package.json tsconfig.json",
    "test:navigation": "node tests/flight-navigation.mjs",
    "test:production": "node tests/production.mjs",
    "test:engineering-02": "node tests/engineering-02.mjs",
    "test:rendering": "node tests/rendering.mjs",
    "test:render-flight": "node tests/render-flight.mjs",
    "test:aurora": "node tests/aurora.mjs",
    "test:right-click": "node tests/right-click.mjs",
    "test:coherence": "node tests/coherence.mjs",
    "test:coherence-journey": "node tests/coherence-journey.mjs",
    "test:performance": "node tests/performance.mjs",
    "test:resource-soak": "node tests/resource-soak.mjs",
    "test:save-browser": "node tests/save-browser.mjs",
    "test:device": "node tests/device-compatibility.mjs",
    "record:exploration": "node tests/device-observer.mjs",
    "test:opening": "node tests/opening.mjs",
    "test:audio": "node tests/audio.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.20.5",
    "@types/three": "^0.180.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "4.1.12"
  }
}
